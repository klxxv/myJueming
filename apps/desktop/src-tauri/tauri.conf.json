{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "决明对齐器 Jueming Aligner",
  "version": "0.1.1",
  "identifier": "com.jueming.aligner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "决明对齐器 Jueming Aligner",
        "width": 1448,
        "height": 1086,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "upgradeCode": "2e90697d-b29d-58f5-b283-b08403419c63",
        "template": "wix/main.wxs",
        "language": {
          "zh-CN": { "localePath": "wix/locales/zh-CN.wxl" },
          "en-US": { "localePath": "wix/locales/en-US.wxl" },
          "fr-FR": { "localePath": "wix/locales/fr-FR.wxl" }
        }
      },
      "nsis": {
        "languages": ["SimpChinese", "English", "French"],
        "displayLanguageSelector": true
      }
    }
  }
}
